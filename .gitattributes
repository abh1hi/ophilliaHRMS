# Ensure shell scripts always use LF line endings in the repo and on checkout
*.sh text eol=lf

# Keep Python files with LF
*.py text eol=lf

# Docker and config files
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
*.env text eol=lf
*.env.* text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.toml text eol=lf

# Everything else uses system default
* text=auto
